# ── Enquiry form delivery ──────────────────────────────────────────
# Configure ONE of the options below. Until you do, the contact form
# falls back to opening the visitor's mail client / WhatsApp with the
# enquiry pre-filled, so no lead is lost.

# Option A — post to any webhook (Zapier, Make, Slack, your CRM)
# ENQUIRY_WEBHOOK_URL="https://hooks.example.com/..."

# Option B — send email via Resend (https://resend.com)
# RESEND_API_KEY="re_..."
# ENQUIRY_TO_EMAIL="mail@hi-techtreads.com"
# ENQUIRY_FROM_EMAIL="website@yourverifieddomain.com"

# ── Review submissions ─────────────────────────────────────────────
# Reviews are moderated, never auto-published: submissions are forwarded
# here and the approved text is added to src/data/reviews.ts by hand.
# Both settings fall back to the enquiry ones above, so a single webhook
# or Resend key covers both forms.

# REVIEW_WEBHOOK_URL="https://hooks.example.com/..."
# REVIEW_TO_EMAIL="mail@hi-techtreads.com"

# ── Site ───────────────────────────────────────────────────────────
# Canonical origin, used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="https://www.mannarubber.com"
