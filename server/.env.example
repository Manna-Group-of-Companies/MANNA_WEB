# Port the API listens on (the Vite dev proxy expects 4000).
PORT=4000

# node | production
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Serve the built client from ../client/dist as well as the API.
SERVE_CLIENT=false

# ── Google sign-in ────────────────────────────────────────────────
# OAuth 2.0 Web client id from https://console.cloud.google.com/apis/credentials
# Must be the SAME value as the client's VITE_GOOGLE_CLIENT_ID — the server
# rejects any ID token issued for a different client.
GOOGLE_CLIENT_ID=127207137422-1380j29k4ru6d6uh4ujf6g7qnpu19but.apps.googleusercontent.com

# Signs the session cookie. Any long random string; required in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# How long a sign-in lasts.
SESSION_TTL_DAYS=30

# Name of the session cookie.
SESSION_COOKIE_NAME=manna_session

# Send the cookie only over HTTPS. Defaults to true in production.
COOKIE_SECURE=false
