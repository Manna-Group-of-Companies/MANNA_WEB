# Leave empty in development — Vite proxies /api to http://localhost:4000.
# Set this only when the API is served from a different origin in production
# (see .env.production). No trailing slash.
VITE_API_BASE_URL=

# OAuth 2.0 Web client id from https://console.cloud.google.com/apis/credentials
# Same value as the server's GOOGLE_CLIENT_ID. Safe to ship to the browser —
# the secret is never used by this flow.
VITE_GOOGLE_CLIENT_ID=

# Never put the OAuth client secret in this directory. Anything here is either
# committed or bundled into the browser build; the secret belongs in server/.env.
